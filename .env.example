# Notion public API integration token. Server-side only.
NOTION_API_KEY=
NOTION_VERSION=2026-03-11

# HGS Notion data source IDs
HGS_DS_INTEGRATIONS=70a13f8e-f94e-4873-b036-b169493f1e95
HGS_DS_COMMANDS=002179d2-d5b2-47f5-bb92-3c0169b5fc33
HGS_DS_METRICS=730472cb-c27d-4b6a-a938-10b6a06bab81
HGS_DS_SYNC_LOG=43d29a28-ff12-4a54-8b7d-3632e922b588

# Dashboard access (HTTP Basic over HTTPS)
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=

# Generic signed metric-ingest endpoint
HGS_INGEST_SECRET=

# Google Ads live read via Windsor.ai (server-side only)
WINDSOR_API_KEY=
WINDSOR_REFRESH_INTERVAL=1h
GOOGLE_ADS_ACCOUNT_ID=316-167-9772

# Optional LINE Yahoo Ads account filter. The Windsor.ai line_ads connector must be connected.
LINE_YAHOO_ADS_ACCOUNT_ID=

# LINE Official Account live read + signed webhook
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Stripe read-only dashboard + signed webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Cron authorization for provider-to-Notion sync
CRON_SECRET=

# Optional deployment metadata
NEXT_PUBLIC_HGS_NAME=HGS Control Center
NEXT_PUBLIC_NOTION_CONTROL_CENTER=https://app.notion.com/p/3e7ec2cce56681ada3d7f3e7d03b77b1
